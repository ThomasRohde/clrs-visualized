---
/**
 * The topbar trigger and the search dialog it opens.
 *
 * A native `<dialog>` opened with `showModal()`, which buys Escape, the focus
 * trap and inerting the page behind it without a line of code — this is the
 * first modal on the site and there was no reason for it to be the first
 * hand-rolled one.
 *
 * The static shell is styled here. **The result rows are not**: the script
 * builds them, so they never carry Astro's scope attribute and cannot be
 * reached from this block. They live in `global.css` with a note saying why,
 * the same arrangement the player's aux chips have.
 */
---

<button class="theme-btn search-btn" id="site-search-btn" type="button">
  <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
    ></path>
  </svg>
  <span class="search-btn-text">Search</span>
  <kbd class="search-btn-key" data-el="search-key">Ctrl K</kbd>
</button>

<dialog id="site-search" class="search-dialog" aria-label="Search the book">
  <div class="search-panel">
    <div class="search-field">
      <svg
        class="search-field-icon"
        width="15"
        height="15"
        viewBox="0 0 16 16"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
        ></path>
      </svg>
      <input
        class="search-input"
        data-el="search-input"
        type="text"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
        aria-label="Search chapters and algorithms"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        placeholder="Chapters, algorithms, pseudocode…"
      />
      <button class="search-dismiss" type="button" data-el="search-close" aria-label="Close search">
        esc
      </button>
    </div>

    <div
      class="search-results"
      id="search-results"
      data-el="search-results"
      role="listbox"
      aria-label="Search results"
    >
      <p class="search-hint-empty">
        Try <em>quicksort</em>, <em>EXTRACT-MIN</em>, or a phrase you half remember.
      </p>
    </div>

    {
      /*
      Not a live region on every keystroke — that is unreadable. The count is
      written here once typing settles, which is the same conclusion the player
      reached about its narration during playback.
    */
    }
    <p class="sr-only" data-el="search-status" role="status" aria-live="polite"></p>

    <div class="search-foot">
      <span class="search-keys">
        <kbd>↑</kbd><kbd>↓</kbd> move · <kbd>↵</kbd> open · <kbd>esc</kbd> close
      </span>
      <a class="search-all" data-el="search-all" href="#" hidden>See all results →</a>
    </div>
  </div>
</dialog>

<style>
  .search-btn {
    gap: 0.4rem;
  }

  .search-btn-key {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0;
    color: var(--ink-3);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.05em 0.3em;
  }

  /* The dialog fills the viewport and the panel sits inside it, so a click
     anywhere off the panel lands on the dialog itself and closes it. */
  .search-dialog {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 9vh 1rem 1rem;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .search-dialog::backdrop {
    background: var(--scrim);
  }

  .search-panel {
    display: flex;
    flex-direction: column;
    max-width: 640px;
    max-height: min(72vh, 560px);
    margin: 0 auto;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 32px var(--shadow-lift);
    overflow: hidden;
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 0.85rem;
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
  }

  .search-field-icon {
    color: var(--ink-3);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.1rem 0;
  }

  .search-input::placeholder {
    color: var(--ink-3);
  }

  .search-input:focus {
    outline: none;
  }

  /* The panel is what has focus as far as the reader is concerned, so the ring
     goes round the field rather than round an input with no border. */
  .search-field:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .search-dismiss {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--ink-3);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.15em 0.4em;
    cursor: pointer;
  }

  .search-dismiss:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  /* The one scrolling region. Everything above and below it is fixed, so the
     panel never changes height as results come and go. */
  .search-results {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0.35rem;
  }

  .search-hint-empty {
    margin: 0;
    padding: 1.1rem 0.9rem;
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  .search-hint-empty em {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-style: normal;
    color: var(--ink-2);
    background: var(--surface-2);
    border-radius: 3px;
    padding: 0.1em 0.3em;
  }

  .search-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.85rem;
    border-top: 1px solid var(--line);
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--ink-3);
    flex-shrink: 0;
  }

  .search-keys kbd {
    font-family: inherit;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.05em 0.3em;
    margin-right: 0.1em;
  }

  .search-all {
    color: var(--ink-2);
    white-space: nowrap;
  }

  .search-all:hover {
    color: var(--ink);
  }

  /* Under the topbar's own breakpoint the word goes and the icon stays: the
     shortcut chip is meaningless on a phone anyway. */
  @media (max-width: 620px) {
    .search-btn-text,
    .search-btn-key {
      display: none;
    }

    .search-dialog {
      padding: 0.75rem;
    }

    .search-panel {
      max-height: calc(100% - 1.5rem);
    }

    .search-keys {
      display: none;
    }

    .search-foot {
      justify-content: flex-end;
    }
  }
</style>

<script>
  import { mountSearchDialog } from '../search/mount';
  mountSearchDialog();
</script>
