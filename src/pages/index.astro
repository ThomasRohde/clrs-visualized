---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOK, ALL_CHAPTERS } from '../lib/book';
import { chapterHref } from '../lib/paths';
import { ALGORITHMS, requireAlgorithm } from '../algorithms/registry';
import { legendFor, ROLE_VAR } from '../visualizers/roles';

const written = await getCollection('chapters');
const bySlug = new Map(written.map((e) => [e.id, e]));

// The hero runs insertion sort, so its pseudocode is rendered at build time
// and the client script only highlights lines in it.
const hero = requireAlgorithm('insertion-sort');
const heroProc = hero.procedures[hero.procOrder[0]];
const heroLegend = legendFor('insertion-sort');
---

<BaseLayout title="Loop Invariant — Introduction to Algorithms, visualized" fullWidth>
  <section class="hero">
    <div class="hero-copy">
      <p class="label hero-eyebrow">Cormen · Leiserson · Rivest · Stein, 4th edition</p>
      <h1>Read the line. Watch it run.</h1>
      <p class="lede">
        Every algorithm in the book, recorded step by step and replayed against the pseudocode it
        came from. The highlighted line and the data underneath it never disagree, because the
        picture is generated by running the procedure — not drawn to look like it.
      </p>
      <div class="hero-actions">
        <a class="cta" href={chapterHref('getting-started')}>Start at chapter 2</a>
        <span class="hero-meta mono">
          {ALGORITHMS.length} algorithms animated · {ALL_CHAPTERS.length} chapters
        </span>
      </div>
    </div>

    <div class="hero-demo panel" data-el="hero">
      <header class="hero-head">
        <span class="hero-head-name">Insertion sort</span>
        <ul class="legend">
          {
            heroLegend.map(([role, meaning]) => (
              <li class="legend-item">
                <span
                  class:list={['swatch', `swatch-${role}`]}
                  style={`--swatch:var(${ROLE_VAR[role]})`}
                />
                {meaning}
              </li>
            ))
          }
        </ul>
      </header>
      <div class="hero-stage">
        <canvas
          data-el="hero-canvas"
          role="img"
          aria-label="Insertion sort running on an eleven-element array"></canvas>
      </div>
      <div class="hero-code mono" data-el="hero-code" aria-hidden="true">
        <div class="proc-title">{heroProc.title}</div>
        {
          heroProc.lines.map((text, i) => (
            <div class="code-line" data-line={i + 1}>
              <span class="ln">{i + 1}</span>
              <span class="code" style={`padding-left:${(heroProc.indent[i] ?? 0) * 1.25}em`}>
                {text}
              </span>
            </div>
          ))
        }
      </div>
      <p class="hero-note" data-el="hero-note">Insertion sort, running.</p>
    </div>
  </section>

  <section class="outline">
    <h2 class="section-head">The whole book</h2>
    <p class="outline-note">
      Every chapter and appendix of the fourth edition, in the book's own order.
    </p>

    {
      BOOK.map((part) => (
        <div class="part">
          <h3 class="part-head">
            <span class="part-numeral">{part.numeral}</span>
            <span class="part-title">{part.title}</span>
          </h3>
          <ul class="chapter-list">
            {part.chapters.map((c) => (
              <li>
                <a
                  href={chapterHref(c.slug)}
                  class:list={['chapter-row', bySlug.has(c.slug) ? 'is-ready' : 'is-planned']}
                >
                  <span class="ch-num mono">{c.number > 0 ? c.number : '—'}</span>
                  <span class="ch-title">{c.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>

<script>
  import { mountHero } from '../visualizers/hero';
  const root = document.querySelector<HTMLElement>('[data-el="hero"]');
  if (root) {
    mountHero(root).catch((err) => {
      // The chunk failed to load. Reveal the panel anyway: the pseudocode and
      // legend are already in the HTML.
      console.error(err);
      root.dataset.ready = 'true';
    });
  }
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    padding: 1rem 0 1.5rem;
  }

  .hero-copy {
    max-width: 46ch;
  }

  .hero-eyebrow {
    margin: 0 0 1rem;
    color: var(--ink-3);
  }

  .hero h1 {
    font-size: var(--t-hero);
    font-weight: 800;
    line-height: 1.04;
    margin-bottom: 1rem;
  }

  .lede {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0 0 1.75rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta {
    display: inline-block;
    background: var(--ink);
    color: var(--surface);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: -0.02em;
    padding: 0.7rem 1.1rem;
    border-radius: var(--radius);
  }

  .cta:hover {
    opacity: 0.86;
  }

  .hero-meta {
    font-size: var(--t-micro);
    color: var(--ink-3);
    line-height: 1.5;
  }

  .hero-demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 15.5rem);
    grid-template-areas:
      'head head'
      'stage code'
      'note code';
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* The landing page is where a reader meets the colour code, so the key
     comes with the first thing they see moving. */
  .hero-head {
    grid-area: head;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem 1.25rem;
    flex-wrap: wrap;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .hero-head-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.74rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--ink-2);
    white-space: nowrap;
  }

  .swatch {
    width: 9px;
    height: 11px;
    background: var(--swatch);
    border-radius: 2px 2px 0 0;
    flex-shrink: 0;
  }

  .swatch-done {
    border-radius: 0;
  }

  .swatch-move {
    outline: 1.5px solid var(--ink);
    outline-offset: -1.5px;
  }

  .hero-demo[data-ready] {
    opacity: 1;
  }

  .hero-stage {
    grid-area: stage;
    padding: 0.75rem 0.85rem 0;
    min-width: 0;
  }

  .hero-stage canvas {
    width: 100%;
    height: 224px;
    display: block;
  }

  .hero-code {
    grid-area: code;
    border-left: 1px solid var(--line);
    background: var(--surface-2);
    padding: 0.75rem 0.7rem;
    font-size: 0.72rem;
    line-height: 1.75;
    overflow: hidden;
  }

  .hero-code .proc-title {
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.4rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--line);
  }

  .hero-code .code-line {
    display: flex;
    gap: 0.5rem;
    padding: 0 0.25rem;
    border-left: 2px solid transparent;
    border-radius: 3px;
  }

  .hero-code .ln {
    color: var(--ink-3);
    width: 1rem;
    text-align: right;
    flex-shrink: 0;
  }

  .hero-code .code {
    color: var(--ink-2);
    white-space: pre-wrap;
    min-width: 0;
  }

  .hero-code .code-line.active {
    background: var(--c-scope-wash);
    border-left-color: var(--c-scope);
  }

  .hero-code .code-line.active .ln {
    color: var(--c-scope);
    font-weight: 600;
  }

  .hero-code .code-line.active .code {
    color: var(--ink);
  }

  .hero-note {
    grid-area: note;
    margin: 0;
    padding: 0.5rem 0.85rem 0.8rem;
    font-size: var(--t-small);
    color: var(--ink-2);
    min-height: calc(2 * 1.45 * var(--t-small));
    line-height: 1.45;
  }

  /* ---------- section headings ---------- */
  .section-head {
    font-size: var(--t-h2);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  /* ---------- outline ---------- */
  .outline-note {
    max-width: var(--measure);
    color: var(--ink-2);
    font-size: var(--t-small);
    margin: -0.25rem 0 1.5rem;
  }

  .part {
    margin-bottom: 1.5rem;
  }

  .part-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .part-numeral {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.78rem;
    color: var(--ink);
    letter-spacing: 0;
    min-width: 2.2rem;
  }

  .part-title {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .chapter-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 0 1.25rem;
  }

  .chapter-row {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: baseline;
    padding: 0.32rem 0.45rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-size: var(--t-small);
    border-left: 2px solid transparent;
  }

  .chapter-row:hover {
    background: var(--surface);
  }

  .ch-num {
    font-size: var(--t-micro);
    color: var(--ink-3);
    text-align: right;
  }

  .chapter-row.is-ready {
    color: var(--ink);
  }

  .chapter-row.is-ready .ch-num {
    color: var(--c-scope);
  }

  .chapter-row.is-planned {
    color: var(--ink-3);
  }

  @media (max-width: 1000px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }

    .hero-copy {
      max-width: none;
    }
  }

  @media (max-width: 620px) {
    .hero-demo {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'head'
        'stage'
        'note'
        'code';
    }

    .hero-code {
      border-left: none;
      border-top: 1px solid var(--line);
    }

    .hero-stage canvas {
      height: 180px;
    }
  }
</style>
